#!/bin/sh

# This script compares the version of the PKGBUILD with the version that was
# already released, and with the upstream version. This is to avoid rebuilding a
# package that is already released and to avoid pushing packages that are too
# new causing partial updates as result

set -e

pkgver=$(awk -F'=' '/pkgver=/{print $2; exit}' "$PKGBUILD")
pkgrel=$(awk -F'=' '/pkgrel=/{print $2; exit}' "$PKGBUILD")
CURRENT_VERSION="$pkgver"-"$pkgrel"
RELEASED_VERSION=$(wget -qO- --retry-connrefused --tries=10 \
	"https://github.com/${GITHUB_REPOSITORY:-pkgforge-dev/archlinux-pkgs-debloated}/releases/download/continuous/$BUILD_SCRIPT-$ARCH.pkgver") || :

case "$FORCE_BUILD" in
	1) FORCE_RELEASED=1; FORCE_UPSTREAM=0;; # build even if already released
	2) FORCE_RELEASED=0; FORCE_UPSTREAM=1;; # build even if upstream does not match
	3) FORCE_RELEASED=1; FORCE_UPSTREAM=1;; # build even if both
	*) FORCE_RELEASED=0; FORCE_UPSTREAM=0;; # normal, no override
esac

echo "----------------------------------------------------------------"
echo "PKGBUILD version: $CURRENT_VERSION"
echo "RELEASED version: ${RELEASED_VERSION:-none}"
if [ "$FORCE_RELEASED" = 1 ]; then
	echo "FORCE_BUILD=$FORCE_BUILD, ignoring the released version..."
	echo "----------------------------------------------------------------"
elif [ -n "$RELEASED_VERSION" ] && [ "$RELEASED_VERSION" = "$CURRENT_VERSION" ]; then
	>&2 echo "ABORTING BUILD BECAUSE THIS VERSION IS ALREADY RELEASED!"
	>&2 echo "----------------------------------------------------------------"
	:> ~/OPERATION_ABORTED
	exit 1
else
	echo "Version differs from the released one, continuing..."
	echo "----------------------------------------------------------------"
fi

UPSTREAM_VERSION=$(pacman -Ss "^$PACKAGE$" | awk '{print $2; exit}' | sed 's/^[0-9]\+://')

echo "UPSTREAM version: $UPSTREAM_VERSION"
if [ "$FORCE_UPSTREAM" = 1 ]; then
	echo "FORCE_BUILD=$FORCE_BUILD, ignoring the upstream version..."
else
	CMP=$(vercmp "$CURRENT_VERSION" "$UPSTREAM_VERSION")
	if [ "$CMP" != 0 ]; then
		if [ "$CMP" -gt 0 ]; then
			>&2 echo "PKGBUILD ($CURRENT_VERSION) is newer than upstream ($UPSTREAM_VERSION)"
		else
			>&2 echo "PKGBUILD ($CURRENT_VERSION) is older than upstream ($UPSTREAM_VERSION)"
		fi
		>&2 echo "ABORTING BUILD BECAUSE OF VERSION MISMATCH WITH UPSTREAM!"
		>&2 echo "----------------------------------------------------------------"
		:> ~/OPERATION_ABORTED
		exit 1
	fi
fi
echo "Building package..."
echo "----------------------------------------------------------------"
