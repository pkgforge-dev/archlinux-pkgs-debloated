#!/bin/sh

set -eu

ARCH_REPO=https://gitlab.archlinux.org/archlinux/packaging/packages
ALARM_REPO=https://github.com/archlinuxarm/PKGBUILDs.git
AUR_REPO=https://aur.archlinux.org

# ArchlinuxARM has all the PKGBUILDs in a single repository instead
ALARM_DIR="${TMPDIR:-/tmp}"/ALARM-PKGBUILDS

if [ -n "${PKGBUILD_REPO:-}" ]; then
	git clone --depth 1 "$PKGBUILD_REPO" "$BUILD_DIR"
elif [ -n "${AUR_PACKAGE:-}" ]; then
	git clone --depth 1 "$AUR_REPO"/"$AUR_PACKAGE".git "$BUILD_DIR"
elif [ "$ARCH" = 'x86_64' ]; then
	git clone --depth 1 "$ARCH_REPO"/"$PACKAGE" "$BUILD_DIR"
elif [ "$ARCH" = 'aarch64' ]; then
	git clone --depth 1 "$ALARM_REPO" "$ALARM_DIR"
	# if ALARM does not have the package, then use the archlinux package directly
	if [ -d "$ALARM_DIR"/*/"$PACKAGE" ]; then
		mv -v "$ALARM_DIR"/*/"$PACKAGE" "$BUILD_DIR"
	else
		>&2 echo "----------------------------------------"
		>&2 echo "ArchlinuxARM does not have '$PACKAGE'"
		>&2 echo "Using Archlinux PKGBUILD instead..."
		>&2 echo "----------------------------------------"
		git clone --depth 1 "$ARCH_REPO"/"$PACKAGE" "$BUILD_DIR"
	fi
	rm -rf "$ALARM_DIR"
else
	# the port monorepos do not carry every package, the archlinux PKGBUILD
	# works for x86_64 and most ported arches after the arch sed below
	git clone --depth 1 "$ARCH_REPO"/"$PACKAGE" "$BUILD_DIR"
fi

echo "----------------------------------------"
ls -la "$BUILD_DIR"
echo "----------------------------------------"

# change arch for foreign arch support, even port PKGBUILDs need this...
# note the port arch name can differ from uname -m (loongarch64 vs loong64)
case "$ARCH" in
	'loongarch64') PKGARCH=loong64 ;;
	'ppc64le')     PKGARCH=powerpc64le ;;
	'ppc64')       PKGARCH=powerpc64 ;;
	*)             PKGARCH=$ARCH ;;
esac
if ! grep -q "arch=.*$PKGARCH" "$PKGBUILD"; then
	sed -i -e "s|x86_64|$PKGARCH|" "$PKGBUILD"
fi

# always build without debug info
sed -i -e 's|-g1|-g0|' "$PKGBUILD"

echo "----------------------------------------"
echo "----------------------------------------"
echo "TOTAL CPU CORES: $(nproc)"
echo "----------------------------------------"
echo "----------------------------------------"
