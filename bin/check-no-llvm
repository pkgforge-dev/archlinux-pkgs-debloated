#!/bin/sh

# Fail when a built driver still links against llvm.
# ldd cannot be used for this: it resolves the transitive dependencies of the
# build container, which has llvm-libs installed.
# Usage: check-no-llvm <package file>...

set -e

_err_msg(){
	>&2 printf '\033[1;31m%s\033[0m\n' " $*"
}

_dir=${TMPDIR:-/tmp}/.check-no-llvm.$$
rm -rf "$_dir"
mkdir "$_dir"

for pkg do
	# unmatched globs arrive literally, the ported arches build no vulkan drivers
	[ -f "$pkg" ] || continue
	tar -xf "$pkg" -C "$_dir"
done

set -- \
	"$_dir"/*.so*     \
	"$_dir"/*/*.so*   \
	"$_dir"/*/*/*.so* \
	"$_dir"/*/*/*/*.so*

_count=0
_ret=0
for so do
	# skip the symlinks, the real file is matched by the same globs
	[ -f "$so" ] && [ ! -L "$so" ] || continue
	_count=$((_count + 1))
	_needed=$(patchelf --print-needed "$so" 2>/dev/null) || continue
	case "$_needed" in
		*libLLVM*)
			_err_msg "${so##*/} links against llvm:"
			echo "$_needed" | grep libLLVM
			_ret=1
			;;
	esac
done

rm -rf "$_dir"

if [ "$_ret" = 1 ]; then
	_err_msg "ERROR: the drivers must not link against llvm!"
	exit 1
fi

if [ "$_count" = 0 ]; then
	_err_msg "ERROR: no libraries were found to check!"
	exit 1
fi
