#!/bin/sh

# Prints the version of $PACKAGE that the pacman repositories of this
# container carry, epoch included ([epoch:]pkgver-pkgrel), or nothing when no
# repository has it.
#
# Inside the builder image the repositories are the ones of the architecture
# being built: Archlinux on x86_64, ArchlinuxARM on aarch64, and the port
# repositories (Arch Linux RISC-V, Loong Arch Linux, ArchPOWER) on riscv64,
# loongarch64, ppc64le and ppc64. So the answer is the version the matching
# archlinux fork ships.

pacman -Ss "^$PACKAGE$" | awk '{print $2; exit}'
