#!/bin/sh

set -e

echo "------------------------------------------------------------"
# The archlinux images ship an initialized keyring and are refreshed daily.
# Only install what the version check needs; check-upstream-version installs
# the build dependencies when a package is actually going to be built.
echo "Installing the packages needed to check versions..."
# -Sy keeps skip jobs from applying a full upgrade; the upgrade before a build
# happens in install_build_deps
pacman -Sy --needed --noconfirm \
	git   \
	patch \
	wget

echo "------------------------------------------------------------"
echo "Settings up build options..."
cp -v ./aux/makepkg.conf."$(uname -m)" /etc/makepkg.conf
cat /etc/makepkg.conf

echo "------------------------------------------------------------"
echo "Hacking makepkg to allow building as root in the container..."
sed -i 's|EUID == 0|EUID == 69|g' /usr/bin/makepkg
mkdir -p /usr/local/bin
cp /usr/bin/makepkg /usr/local/bin

echo "------------------------------------------------------------"
echo "Setting up swap..."
if [ ! -e "$PWD"/swapfile2 ]; then
	fallocate -l 5G "$PWD"/swapfile2 || dd if=/dev/zero of="$PWD"/swapfile2 bs=1M count=5120
	chmod 600 "$PWD"/swapfile2
	mkswap "$PWD"/swapfile2
	swapon "$PWD"/swapfile2
fi
free -h
swapon --show
