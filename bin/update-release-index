#!/bin/sh

# Regenerates `packages.txt` from the current `.pkg.tar.zst` assets of the
# `continuous` release and uploads it back to the same release.
#
# Uses `gh` when installed, or falls back to `curl` + GitHub REST API (with
# `GITHUB_TOKEN` / `GH_TOKEN`) so it runs both on Ubuntu runners and inside
# minimal Arch build containers without `gh`.
#
# Optional env vars:
#   GITHUB_REPOSITORY  (default: pkgforge-dev/archlinux-pkgs-debloated)
#   RELEASE_TAG        (default: continuous)
#   OUT_DIR            directory to write packages.txt into
#   DRY_RUN=1          generate packages.txt without uploading

set -eu

REPO=${GITHUB_REPOSITORY:-pkgforge-dev/archlinux-pkgs-debloated}
TAG=${RELEASE_TAG:-continuous}
DRY_RUN=${DRY_RUN:-0}
TOKEN=${GH_TOKEN:-${GITHUB_TOKEN:-}}

WORKDIR=$(mktemp -d)
trap 'rm -rf "$WORKDIR"' INT TERM EXIT
OUT_DIR=${OUT_DIR:-$WORKDIR/out}
mkdir -p "$OUT_DIR"

fetch_assets() {
	if command -v gh >/dev/null 2>&1; then
		gh release view "$TAG" --repo "$REPO" --json assets \
			--jq '.assets[].url'
	else
		auth_header=""
		if [ -n "$TOKEN" ]; then
			auth_header="Authorization: Bearer $TOKEN"
		fi
		curl -fsSL --retry 5 --retry-connrefused \
			-H "Accept: application/vnd.github+json" \
			${auth_header:+-H "$auth_header"} \
			"https://api.github.com/repos/$REPO/releases/tags/$TAG" \
			| sed 's/[()",{} ]/\n/g' \
			| grep -o 'https://[^"]*\.pkg\.tar\.zst'
	fi
}

upload_file() {
	file="$1"
	if command -v gh >/dev/null 2>&1; then
		gh release upload "$TAG" "$file" --repo "$REPO" --clobber
		return
	fi
	if [ -z "$TOKEN" ]; then
		>&2 echo "ERROR: GH_TOKEN or GITHUB_TOKEN is required to upload without gh"
		exit 1
	fi
	rel_json="$WORKDIR/release.json"
	curl -fsSL --retry 5 --retry-connrefused \
		-H "Accept: application/vnd.github+json" \
		-H "Authorization: Bearer $TOKEN" \
		"https://api.github.com/repos/$REPO/releases/tags/$TAG" > "$rel_json"
	rel_id=$(sed -n 's/^[[:space:]]*"id":[[:space:]]*\([0-9][0-9]*\),.*/\1/p' "$rel_json" | head -n 1)
	if [ -z "$rel_id" ]; then
		>&2 echo "ERROR: failed to resolve release id for $REPO@$TAG"
		exit 1
	fi
	name="${file##*/}"
	existing_id=$(awk -v target="\"$name\"" '
		/"id":[[:space:]]*[0-9]+,/ { sub(/.*"id":[[:space:]]*/, ""); sub(/,.*/, ""); last_id=$0 }
		/"name":[[:space:]]*/ && index($0, target) { print last_id; exit }
	' "$rel_json")
	if [ -n "$existing_id" ]; then
		curl -fsSL -X DELETE --retry 3 \
			-H "Accept: application/vnd.github+json" \
			-H "Authorization: Bearer $TOKEN" \
			"https://api.github.com/repos/$REPO/releases/assets/$existing_id" >/dev/null || true
	fi
	curl -fsSL -X POST --retry 5 --retry-connrefused \
		-H "Accept: application/vnd.github+json" \
		-H "Authorization: Bearer $TOKEN" \
		-H "Content-Type: text/plain" \
		--data-binary "@$file" \
		"https://uploads.github.com/repos/$REPO/releases/$rel_id/assets?name=$name" >/dev/null
}

fetch_assets \
	| grep '\.pkg\.tar\.zst$' \
	| LC_ALL=C sort -u > "$OUT_DIR/packages.txt"

if [ ! -s "$OUT_DIR/packages.txt" ]; then
	>&2 echo "ERROR: no .pkg.tar.zst assets found in $REPO@$TAG"
	exit 1
fi

echo "Generated packages.txt ($(wc -l < "$OUT_DIR/packages.txt") entries)"

if [ "$DRY_RUN" != 1 ]; then
	upload_file "$OUT_DIR/packages.txt"
fi
