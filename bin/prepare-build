#!/bin/sh

set -e

echo "------------------------------------------------------------"
# the builder image already ships the toolchain, so only install it when
# running against a plain archlinux image (or a stale builder image)
_install=
for _cmd in ccache clang cmake curl mold ninja git wget; do
	command -v "$_cmd" >/dev/null 2>&1 || _install=1
done

if [ -n "$_install" ]; then
	echo "Installing basic packages..."
	pacman-key --init
	# ArchPOWER's `archpower-keyring` (in `base/any`) provides and replaces
	# `archlinux-keyring`, so the install below is just a no-op reinstall on
	# ppc64/ppc64le; skip it on those arches
	case "$(uname -m)" in
		ppc64|ppc64le) : ;;
		*) pacman -Syy --noconfirm archlinux-keyring ;;
	esac
	pacman -Syu --needed --noconfirm \
		base-devel \
		ccache     \
		clang      \
		cmake      \
		curl       \
		git        \
		mold       \
		ninja      \
		wget
else
	echo "Basic packages already installed"
fi

echo "------------------------------------------------------------"
echo "Settings up build options..."
cp -v ./aux/makepkg.conf."$(uname -m)" /etc/makepkg.conf
cat /etc/makepkg.conf

echo "------------------------------------------------------------"
echo "Hacking makepkg to allow building as root in the container..."
sed -i 's|EUID == 0|EUID == 69|g' /usr/bin/makepkg
mkdir -p /usr/local/bin
cp /usr/bin/makepkg /usr/local/bin

echo "------------------------------------------------------------"
echo "Setting up swap..."
if [ ! -e "$PWD"/swapfile2 ]; then
	fallocate -l 5G "$PWD"/swapfile2 || dd if=/dev/zero of="$PWD"/swapfile2 bs=1M count=5120
	chmod 600 "$PWD"/swapfile2
	mkswap "$PWD"/swapfile2
	swapon "$PWD"/swapfile2
fi
free -h
swapon --show
