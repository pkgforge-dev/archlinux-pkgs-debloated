#!/bin/sh

# Regenerates `packages.txt` and per-arch `common-{mini,nano}-<arch>.tar`
# bundles from the current assets of the `continuous` release, and uploads them
# back to the same release.
#
# Modes:
#   packages.txt only:  bin/update-release-index --index-only
#   index + bundles:    bin/update-release-index
#
# Uses `gh` when installed, or falls back to `curl` + GitHub REST API (with
# `GITHUB_TOKEN` / `GH_TOKEN`) so it runs both on Ubuntu runners and inside
# minimal Arch build containers without `gh`.
#
# Optional env vars:
#   GITHUB_REPOSITORY  (default: pkgforge-dev/archlinux-pkgs-debloated)
#   RELEASE_TAG        (default: continuous)
#   BUNDLE_ARCH        limit bundle rebuilds to one arch (empty = all)
#   DRY_RUN=1          build into OUT_DIR without uploading

set -eu

REPO=${GITHUB_REPOSITORY:-pkgforge-dev/archlinux-pkgs-debloated}
TAG=${RELEASE_TAG:-continuous}
INDEX_ONLY=0
BUNDLE_ARCH=${BUNDLE_ARCH:-}
DRY_RUN=${DRY_RUN:-0}
TOKEN=${GH_TOKEN:-${GITHUB_TOKEN:-}}

while [ "$#" -gt 0 ]; do
	case "$1" in
		--index-only)
			INDEX_ONLY=1
			shift
			;;
		--arch)
			BUNDLE_ARCH="$2"
			shift 2
			;;
		*)
			>&2 echo "ERROR: unknown option: $1"
			exit 1
			;;
	esac
done

WORKDIR=$(mktemp -d)
trap 'rm -rf "$WORKDIR"' INT TERM EXIT
OUT_DIR=${OUT_DIR:-$WORKDIR/out}
mkdir -p "$OUT_DIR"

ASSETS_FILE="$WORKDIR/assets.txt"

fetch_assets() {
	if command -v gh >/dev/null 2>&1; then
		gh release view "$TAG" --repo "$REPO" --json assets \
			--jq '.assets[].url'
	else
		auth_header=""
		if [ -n "$TOKEN" ]; then
			auth_header="Authorization: Bearer $TOKEN"
		fi
		curl -fsSL --retry 5 --retry-connrefused \
			-H "Accept: application/vnd.github+json" \
			${auth_header:+-H "$auth_header"} \
			"https://api.github.com/repos/$REPO/releases/tags/$TAG" \
			| sed 's/[()",{} ]/\n/g' \
			| grep -o 'https://[^"]*\.pkg\.tar\.zst'
	fi
}

upload_files() {
	if command -v gh >/dev/null 2>&1; then
		gh release upload "$TAG" "$@" --repo "$REPO" --clobber
		return
	fi
	if [ -z "$TOKEN" ]; then
		>&2 echo "ERROR: GH_TOKEN or GITHUB_TOKEN is required to upload without gh"
		exit 1
	fi
	rel_json="$WORKDIR/release.json"
	curl -fsSL --retry 5 --retry-connrefused \
		-H "Accept: application/vnd.github+json" \
		-H "Authorization: Bearer $TOKEN" \
		"https://api.github.com/repos/$REPO/releases/tags/$TAG" > "$rel_json"
	rel_id=$(sed -n 's/^[[:space:]]*"id":[[:space:]]*\([0-9][0-9]*\),.*/\1/p' "$rel_json" | head -n 1)
	if [ -z "$rel_id" ]; then
		>&2 echo "ERROR: failed to resolve release id for $REPO@$TAG"
		exit 1
	fi
	for f in "$@"; do
		name="${f##*/}"
		# Delete existing asset with same name if present (clobber)
		existing_id=$(awk -v target="\"$name\"" '
			/"id":[[:space:]]*[0-9]+,/ { sub(/.*"id":[[:space:]]*/, ""); sub(/,.*/, ""); last_id=$0 }
			/"name":[[:space:]]*/ && index($0, target) { print last_id; exit }
		' "$rel_json")
		if [ -n "$existing_id" ]; then
			curl -fsSL -X DELETE --retry 3 \
				-H "Accept: application/vnd.github+json" \
				-H "Authorization: Bearer $TOKEN" \
				"https://api.github.com/repos/$REPO/releases/assets/$existing_id" >/dev/null || true
		fi
		curl -fsSL -X POST --retry 5 --retry-connrefused \
			-H "Accept: application/vnd.github+json" \
			-H "Authorization: Bearer $TOKEN" \
			-H "Content-Type: application/octet-stream" \
			--data-binary "@$f" \
			"https://uploads.github.com/repos/$REPO/releases/$rel_id/assets?name=$name" >/dev/null
	done
}

fetch_assets \
	| grep '\.pkg\.tar\.zst$' \
	| LC_ALL=C sort -u > "$ASSETS_FILE"

if [ ! -s "$ASSETS_FILE" ]; then
	>&2 echo "ERROR: no .pkg.tar.zst assets found in $REPO@$TAG"
	exit 1
fi

cp "$ASSETS_FILE" "$OUT_DIR/packages.txt"
echo "Generated packages.txt ($(wc -l < "$OUT_DIR/packages.txt") entries)"

if [ "$INDEX_ONLY" = 1 ]; then
	if [ "$DRY_RUN" != 1 ]; then
		upload_files "$OUT_DIR/packages.txt"
	fi
	exit 0
fi

# Package sets matching get-debloated-pkgs.sh's --add-common (+ --prefer-nano)
common_pkgs_for() {
	arch="$1"
	variant="$2"
	set -- \
		icu-mini \
		opus-mini \
		libxml2-mini \
		qt6-base-mini \
		gtk3-mini \
		gtk4-mini \
		glycin-mini \
		"mesa-$variant"
	if [ "$arch" = "x86_64" ]; then
		set -- "$@" "vulkan-intel-$variant"
	elif [ "$arch" = "aarch64" ]; then
		set -- "$@" \
			"vulkan-panfrost-$variant" \
			"vulkan-freedreno-$variant" \
			"vulkan-broadcom-$variant" \
			"vulkan-asahi-$variant" \
			"vulkan-powervr-$variant"
	fi
	set -- "$@" \
		"vulkan-radeon-$variant" \
		"vulkan-virtio-$variant"
	printf '%s\n' "$@"
}

if [ -n "$BUNDLE_ARCH" ]; then
	ARCHES="$BUNDLE_ARCH"
else
	ARCHES="x86_64 aarch64 riscv64 loongarch64 ppc64le ppc64"
fi

# Cache downloaded .pkg.tar.zst files per arch so mini and nano share common
# packages (icu-mini, qt6-base-mini, gtk3-mini, etc.) without downloading twice.
DL_DIR="$WORKDIR/pkgs"
mkdir -p "$DL_DIR"

for arch in $ARCHES; do
	ARCH_ASSETS="$WORKDIR/assets-$arch.txt"
	grep -- "-${arch}\.pkg\.tar\.zst$" "$ASSETS_FILE" > "$ARCH_ASSETS" || true
	if [ ! -s "$ARCH_ASSETS" ]; then
		echo "Skipping $arch: no .pkg.tar.zst assets in $REPO@$TAG"
		continue
	fi

	for variant in mini nano; do
		BUNDLE_NAME="common-${variant}-${arch}.tar"
		MANIFEST_FILE="$WORKDIR/bundle-${variant}-${arch}.list"
		: > "$MANIFEST_FILE"

		for pkg in $(common_pkgs_for "$arch" "$variant"); do
			url=$(grep -m 1 "/${pkg}-${arch}\.pkg\.tar\.zst$" "$ARCH_ASSETS" || true)
			if [ -z "$url" ]; then
				continue
			fi
			fname="${url##*/}"
			if [ ! -f "$DL_DIR/$fname" ]; then
				curl -fsSL --retry 5 --retry-connrefused -o "$DL_DIR/$fname" "$url"
			fi
			echo "$fname" >> "$MANIFEST_FILE"
		done

		if [ ! -s "$MANIFEST_FILE" ]; then
			echo "Skipping $BUNDLE_NAME: no matching packages"
			continue
		fi

		LC_ALL=C sort -u "$MANIFEST_FILE" -o "$MANIFEST_FILE"
		# Uncompressed tar: the .pkg.tar.zst members are already zstd-compressed.
		tar -C "$DL_DIR" -cf "$OUT_DIR/$BUNDLE_NAME" -T "$MANIFEST_FILE"
		echo "Built $BUNDLE_NAME ($(wc -l < "$MANIFEST_FILE") pkgs, $(du -h "$OUT_DIR/$BUNDLE_NAME" | awk '{print $1}'))"
	done
done

if [ "$DRY_RUN" != 1 ]; then
	upload_files "$OUT_DIR"/*
fi
